# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.html

# Go workspace file
go.work
go.work.sum

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*
vendor/

# editor and IDE paraphernalia
.idea
.vscode
.vs/
*.iml
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Kubeconfig might contain secrets
*.kubeconfig
kubeconfig

# Local environment / secret material - never commit real credentials
.env
.env.*
*.pem
*.key

# Packaged Helm charts and dependency caches (chart-releaser output, `helm dependency` cache)
*.tgz
charts/*.lock
**/charts/*.tgz

# Claude AI local config/session state - not project source
.claude/
AGENTS.md
CLAUDE.md
docs/superpowers
SPEC.md

# dist/ holds only generated output now - the chart moved to helm-dwpk/, and
# install.yaml is regenerated by `make build-installer`. Shipping a build
# artifact in the repository means it is stale the moment anything changes.
/dist/

# mkdocs local build output and Python toolchain artifacts
/site/
__pycache__/
*.pyc
.venv/
venv/

# Node deps, only relevant if semantic-release is run locally
node_modules/
