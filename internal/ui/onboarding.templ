package ui

// OnboardingPage is the four-step first-login wizard: what to do, not a
// gate on doing it. It reuses the tabs/panel machinery the rest of the UI
// already ships (profileTab, activateTabs) so Next/Back is a tab switch with
// no separate stepper state, and adds only the two nav-free buttons
// (data-step-to) wireOnboardingSteps understands.
templ OnboardingPage(data OnboardingData) {
	@pageHeader("Getting started", "A quick walkthrough before you dive in.", nil)
	<div class="tabs" role="tablist" aria-label="Onboarding steps">
		@onboardingStep("step-1", "1. SSH key", true)
		@onboardingStep("step-2", "2. Catalog", false)
		@onboardingStep("step-3", "3. First workspace", false)
		@onboardingStep("step-4", "4. Finish", false)
	</div>
	<div class="tab-panel active" role="tabpanel" data-tab-panel="step-1">
		<section class="panel">
			<h2>Push your SSH key</h2>
			<p>
				Workspaces are reached over SSH through the platform's gateway, the
				same way you would reach any other machine - including the VS Code
				Remote Development extension and the in-browser terminal. Add a
				public key on your profile and every workspace you create will trust
				it automatically.
			</p>
			@sshKeyGuides()
			<a class="button-link" href={ linkPath(ctx, "/profile#keys") }>Add an SSH key</a>
			<div class="wizard-actions">
				<button type="button" data-step-to="step-2">Next</button>
			</div>
		</section>
	</div>
	<div class="tab-panel" role="tabpanel" data-tab-panel="step-2">
		<section class="panel">
			<h2>Browse the catalog</h2>
			<p>
				The catalog is the platform's marketplace: images an administrator
				has approved for you to run, each with its own defaults for CPU,
				memory and storage. Picking one is how you start a workspace - you
				are never asked to write a container image reference yourself.
			</p>
			<a class="button-link" href={ linkPath(ctx, "/catalog") }>Browse the catalog</a>
			<div class="wizard-actions">
				<button type="button" data-step-to="step-1">Back</button>
				<button type="button" data-step-to="step-3">Next</button>
			</div>
		</section>
	</div>
	<div class="tab-panel" role="tabpanel" data-tab-panel="step-3">
		<section class="panel">
			<h2>Start your first workspace</h2>
			<p>
				A workspace is your own running copy of a catalog image, with its
				own storage that survives a restart. Once it is running you can
				reach it with the SSH command on its page, the VS Code Remote
				Development extension, or the terminal built into this UI - whatever
				fits what you are doing.
			</p>
			<a class="button-link" href={ linkPath(ctx, "/catalog") }>Start a workspace</a>
			<div class="wizard-actions">
				<button type="button" data-step-to="step-2">Back</button>
				<button type="button" data-step-to="step-4">Next</button>
			</div>
		</section>
	</div>
	<div class="tab-panel" role="tabpanel" data-tab-panel="step-4">
		<section class="panel">
			<h2>You're set</h2>
			<p>
				That's everything the platform asks of you up front. This walkthrough
				will not show again after you finish it - from here on you land
				straight on your Overview, and every one of the pages above stays
				exactly where it is if you want to come back to any of it.
			</p>
			<form action={ linkPath(ctx, onboardingCompletePath) } method="post">
				<input type="hidden" name="csrf_token" value={ data.Session.CSRFToken }/>
				<div class="wizard-actions">
					<button type="button" data-step-to="step-3">Back</button>
					<button type="submit">Finish</button>
				</div>
			</form>
		</section>
	</div>
}

// onboardingStep is one entry in the step nav row. It is a tab-button like
// profileTab's, just under its own name so a reader does not have to check
// which templ this comes from to know what it renders.
templ onboardingStep(name, label string, selected bool) {
	<button
		type="button"
		class={ "tab-button", templ.KV("active", selected) }
		role="tab"
		aria-selected={ ariaPressed(selected) }
		tabindex={ tabIndexOf(selected) }
		data-tab-button={ name }
	>{ label }</button>
}
