package ui

import workspacepkg "github.com/devops-ia/dwpk/internal/workspace"

import "context"
import "fmt"
// Six panels was a long scroll where nothing related to anything above it.
// Tabs reuse the component from the workspace page - same markup, same
// activateTabs in app.js, same roving tabindex and arrow keys.
templ ProfilePage(data ProfileData) {
	@pageHeader("My profile", "", nil)
	<div class="tabs" role="tablist" aria-label="Profile sections">
		@profileTab("overview", "Overview", true)
		@profileTab("quota", "Quota", false)
		@profileTab("workspaces", "Workspaces", false)
		@profileTab("password", "Password", false)
		@profileTab("keys", "SSH keys", false)
		@profileTab("api", "API", false)
		@profileTab("settings", "Settings", false)
	</div>
	<div class="tab-panel active" role="tabpanel" data-tab-panel="overview">
	<section class="panel">
		<dl class="profile-facts">
			<dt>Email</dt>
			<dd>{ data.Session.Identity.Email }</dd>
			<dt>Username</dt>
			<dd><span class="ident">{ data.Session.Identity.UserSpaceName }</span></dd>
			<dt>Role</dt>
			<dd>{ data.Session.Identity.Role }</dd>
			<dt>Namespace</dt>
			<dd><span class="ident">{ data.Session.Identity.UserSpaceNamespace }</span></dd>
		</dl>
	</section>
	</div>
	<div class="tab-panel" role="tabpanel" data-tab-panel="quota">
	<section class="panel">
		<h2>Quota</h2>
		<ul class="quota-bars">
			@quotaBar("Workspaces", fmt.Sprintf("%d", data.Quota.WorkspaceCount), fmt.Sprintf("%d", data.Quota.WorkspaceLimit))
			@quotaBar("CPU", data.Quota.CPUUsed, data.Quota.CPULimit)
			@quotaBar("Memory", data.Quota.MemoryUsed, data.Quota.MemoryLimit)
			@quotaBar("Storage", data.Quota.StorageUsed, data.Quota.StorageLimit)
		</ul>
	</section>
	</div>
	<div class="tab-panel" role="tabpanel" data-tab-panel="workspaces">
	<section class="panel">
		<h2>My workspaces</h2>
		if len(data.Workspaces) == 0 {
			<div class="empty-state">
				<h2>No workspaces yet</h2>
				<p>Pick an image from the catalog and it will appear here.</p>
				<a class="button-link" href={ linkPath(ctx, "/") }>Browse the catalog</a>
			</div>
		} else {
			<div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
			<table class="admin-table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Image</th>
						<th>Size</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range data.Workspaces {
						<tr>
							<td><a href={ linkPath(ctx, "/w/"+row.Name) }>{ row.Name }</a></td>
							<td>{ row.Image }</td>
							<td>{ row.Size }</td>
							<td>@statusChip(row.Status)</td>
						</tr>
					}
				</tbody>
			</table>
			</div>
		}
	</section>
	</div>
	<div class="tab-panel" role="tabpanel" data-tab-panel="password">
	<section class="panel">
		<h2>Password</h2>
		if data.Error != "" {
			<p class="error">{ data.Error }</p>
		}
		if data.Notice != "" {
			<p class="notice">{ data.Notice }</p>
		}
		if data.LocalUsername == "" {
			<p class="muted">
				You sign in through an identity provider, so your password is managed
				there rather than here.
			</p>
		} else {
			<form action={ linkPath(ctx, "/profile/password") + "#password" } method="post" class="stack-form">
				<input type="hidden" name="csrf_token" value={ data.Session.CSRFToken }/>
				<input type="hidden" name="username" value={ data.LocalUsername } autocomplete="username"/>
				<label for="current-password">
					Current password
					<input type="password" id="current-password" name="current_password" autocomplete="current-password" required/>
				</label>
				<label for="new-password">
					New password
					<input type="password" id="new-password" name="new_password" autocomplete="new-password" required/>
				</label>
				<label for="confirm-password">
					Confirm new password
					<input type="password" id="confirm-password" name="confirm_password" autocomplete="new-password" required/>
				</label>
				<button type="submit">Change password</button>
			</form>
		}
	</section>
	</div>
	<div class="tab-panel" role="tabpanel" data-tab-panel="keys">
		@profileKeysPanel(data)
	</div>
	<div class="tab-panel" role="tabpanel" data-tab-panel="api">
		@profileTokensPanel(data)
	</div>
	<div class="tab-panel" role="tabpanel" data-tab-panel="settings">
		@profileSettingsPanel(ctx)
	</div>
}

// profileSettingsPanel holds per-viewer platform preferences: things that
// belong to the person, not the workspace or the platform's own config. The
// theme choice reuses the cookie the toggle button already writes
// (dwpk_ui_theme, theme.go) - wireThemeToggle in app.js binds this select the
// same way it binds the toggle, so there is no new backend route. There is
// nothing to submit: the choice applies and persists on change.
templ profileSettingsPanel(ctx context.Context) {
	<section class="panel">
		<h2>Appearance</h2>
		<label for="settings-theme">
			Theme
			<select id="settings-theme" name="theme" data-theme-option>
				<option value="light" selected?={ themeOf(ctx) == "light" }>Light</option>
				<option value="dark" selected?={ themeOf(ctx) == "dark" }>Dark</option>
				<option value="system" selected?={ themeOf(ctx) == "" }>Match system</option>
			</select>
		</label>
	</section>
	<section class="panel">
		<h2>Language</h2>
		<label for="settings-language">
			Language
			<select id="settings-language" disabled>
				<option selected>English</option>
			</select>
		</label>
		<p class="muted">More languages coming soon.</p>
	</section>
}

// profileTab is one tab button. The workspace page writes these inline; there
// are six here, so they come from a component rather than six near-identical
// lines that will drift.
templ profileTab(name, label string, selected bool) {
	<button
		type="button"
		class={ "tab-button", templ.KV("active", selected) }
		role="tab"
		aria-selected={ ariaPressed(selected) }
		tabindex={ tabIndexOf(selected) }
		data-tab-button={ name }
	>{ label }</button>
}

// sshKeyGuides points at GitHub's walkthroughs rather than restating them.
// Generating a key pair happens on your own machine, so it is the one part of
// this the platform cannot do for you or check as you go. The links open in a
// new tab because the form above them holds unsaved text.
templ sshKeyGuides() {
	<p class="hint">
		No key yet?
		<a href="https://docs.github.com/en/authentication/connecting-to-github-with-ssh" target="_blank" rel="noopener">Connecting to GitHub with SSH</a>
		covers generating one, and
		<a href="https://docs.github.com/en/authentication/troubleshooting-ssh" target="_blank" rel="noopener">Troubleshooting SSH</a>
		covers a key being refused. The steps are the same here; only the host differs.
	</p>
}

// quotaBar shows one resource as used-of-limit. The bar is a meter rather than
// a coloured div so a screen reader announces the same numbers the eye reads.
templ quotaBar(label, used, limit string) {
	<li class="quota-bar">
		<span class="quota-bar-label">{ label }</span>
		<meter
			min="0"
			max={ quotaMeterMax(limit) }
			value={ quotaMeterValue(used) }
			aria-label={ label + ": " + used + " of " + limit }
		></meter>
		<span class="quota-bar-value">{ used } / { limit }</span>
	</li>
}

// API tokens. The scope picks which ServiceAccount the token authenticates as,
// and that account's RBAC is the whole enforcement - so a read token cannot
// write even if every line of this UI were wrong about it.
templ profileTokensPanel(data ProfileData) {
	if data.Error != "" {
		<p class="error" role="alert">{ data.Error }</p>
	}
	if data.Notice != "" {
		<p class="notice" role="status">{ data.Notice }</p>
	}
	<section class="panel">
		<h2>API tokens</h2>
		if !data.TokensEnabled {
			<p class="muted">
				Token authentication is not configured on this installation, so
				there are no tokens to issue.
			</p>
		} else {
			if data.Issued != "" {
				<div class="notice" role="status">
					<strong>Copy this now - it is not shown again.</strong>
					<div class="command-row">
						<code id="issued-token">{ data.Issued }</code>
						<button type="button" data-copy-target="issued-token">Copy</button>
					</div>
				</div>
			}
			<p class="hint">
				A token can never do more than you can. It authenticates as a
				ServiceAccount in your own namespace, bound to your own rights, so
				your role is its ceiling.
			</p>
			if len(data.Tokens) > 0 {
				<div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
					<table class="admin-table">
						<thead>
							<tr>
								<th>Token</th>
								<th>Scope</th>
								<th>Created</th>
								<th>Expires</th>
								<th><span class="visually-hidden">Actions</span></th>
							</tr>
						</thead>
						<tbody>
							for _, token := range data.Tokens {
								<tr>
									<td><span class="ident">{ token.Name }</span></td>
									<td>{ token.Scope }</td>
									<td>{ token.CreatedAt }</td>
									<td>{ token.Expires }</td>
									<td class="row-actions">
										@confirmDelete(
											"revoke-"+token.Name,
											"token "+token.Name,
											linkPath(ctx, "/profile/tokens/"+token.Name+"/delete")+"#api",
											data.Session.CSRFToken,
											[]string{
												"Anything using this token stops working immediately.",
												"Nothing else is affected: your login, workspaces and other tokens are untouched.",
												"A revoked token cannot be restored. Issue a new one instead.",
											},
										)
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<p class="muted">You have no API tokens.</p>
			}
			<form action={ linkPath(ctx, "/profile/tokens") + "#api" } method="post" class="stack-form form-row">
				<input type="hidden" name="csrf_token" value={ data.Session.CSRFToken }/>
				<label for="token-expires">
					Expires
					<select id="token-expires" name="expires">
						for _, option := range tokenExpiryOptions() {
							<option value={ option.Value }>{ option.Label }</option>
						}
					</select>
				</label>
				<label for="token-scope">
					Scope
					<select id="token-scope" name="scope">
						for _, scope := range workspacepkg.TokenScopes() {
							<option value={ string(scope) }>{ scopeLabel(scope) }</option>
						}
					</select>
				</label>
				<button type="submit">Issue token</button>
			</form>
		}
	</section>
}

// Default SSH keys. These are copied onto a workspace when it is created and
// not kept in sync afterwards, which the panel says out loud - otherwise the
// obvious assumption is that removing a key here locks you out of a machine you
// are currently working on, and it does not.
templ profileKeysPanel(data ProfileData) {
	if data.Error != "" {
		<p class="error" role="alert">{ data.Error }</p>
	}
	if data.Notice != "" {
		<p class="notice" role="status">{ data.Notice }</p>
	}
	<section class="panel">
		<h2>SSH public keys</h2>
		<p class="hint">
			Copied onto every workspace you create. Existing workspaces keep the
			keys they already have, so adding one here does not reach into a
			machine that is running, and removing one does not lock you out of it.
		</p>
		if len(data.Keys) == 0 {
			<p class="muted">
				No keys yet. Without one you will be asked for a key each time you
				create a workspace.
			</p>
		} else {
			<div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
				<table class="admin-table">
					<thead>
						<tr>
							<th>Type</th>
							<th>Comment</th>
							<th>Fingerprint</th>
							<th><span class="visually-hidden">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, key := range data.Keys {
							<tr>
								<td><span class="ident">{ key.Type }</span></td>
								<td>{ orDash(key.Comment) }</td>
								<td><span class="ident-muted">{ orDash(key.Fingerprint) }</span></td>
								<td class="row-actions">
									<form action={ linkPath(ctx, "/profile/keys/delete") + "#keys" } method="post">
										<input type="hidden" name="csrf_token" value={ data.Session.CSRFToken }/>
										<input type="hidden" name="key" value={ key.Value }/>
										<button type="submit" class="secondary">Remove</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<form action={ linkPath(ctx, "/profile/keys") + "#keys" } method="post" class="stack-form">
			<input type="hidden" name="csrf_token" value={ data.Session.CSRFToken }/>
			<label for="new-key">
				Add a key
				<textarea id="new-key" name="key" rows="3" required placeholder="ssh-ed25519 AAAA... you@laptop"></textarea>
				<span class="hint">
					The contents of a .pub file. ssh-rsa, ecdsa-sha2-nistp256/384/521,
					ssh-ed25519 and the sk- security-key forms are all accepted.
				</span>
			</label>
			@sshKeyGuides()
			<button type="submit">Add key</button>
		</form>
	</section>
	@profileGitSSHKeysPanel(data)
}

// Private keys for git access to the person's own repositories - a
// different thing from the public keys above (those are for reaching a
// workspace; these are for a workspace reaching somewhere else). Mounted
// into every workspace in this person's namespace automatically, one per
// host, so a change here reaches an already-running workspace on its next
// restart without anything being typed into it by hand.
templ profileGitSSHKeysPanel(data ProfileData) {
	<section class="panel">
		<h2>Git SSH keys</h2>
		<p class="hint">
			A private key per host, so a workspace can `git clone`/`git pull` your
			own private repositories without a key being added to each one by
			hand. Mounted read-only outside your home directory; git already
			respects it via <code>GIT_SSH_COMMAND</code>. A plain `ssh` (not
			through git) needs <code>-F /etc/dwpk/git-ssh/config</code>
			explicitly, or add <code>Include /etc/dwpk/git-ssh/config</code> to
			your own <code>~/.ssh/config</code>.
		</p>
		if len(data.GitSSHKeys) == 0 {
			<p class="muted">No keys yet.</p>
		} else {
			<div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
				<table class="admin-table">
					<thead>
						<tr>
							<th>Host</th>
							<th>Type</th>
							<th>Fingerprint</th>
							<th><span class="visually-hidden">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, key := range data.GitSSHKeys {
							<tr>
								<td><span class="ident">{ key.Host }</span></td>
								<td>{ orDash(key.KeyType) }</td>
								<td><span class="ident-muted">{ orDash(key.Fingerprint) }</span></td>
								<td class="row-actions">
									<form action={ linkPath(ctx, "/profile/git-ssh-keys/delete") + "#keys" } method="post">
										<input type="hidden" name="csrf_token" value={ data.Session.CSRFToken }/>
										<input type="hidden" name="host" value={ key.Host }/>
										<button type="submit" class="secondary">Remove</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<form action={ linkPath(ctx, "/profile/git-ssh-keys") + "#keys" } method="post" class="stack-form">
			<input type="hidden" name="csrf_token" value={ data.Session.CSRFToken }/>
			<label for="git-ssh-host">
				Host
				<input id="git-ssh-host" name="host" required placeholder="github.com"/>
			</label>
			<label for="git-ssh-key">
				Private key
				<textarea id="git-ssh-key" name="key" rows="6" required placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea>
				<span class="hint">
					Must have no passphrase - a workspace has nowhere to prompt for one.
					Strip one first with <code>ssh-keygen -p -f &lt;file&gt; -N ""</code>.
				</span>
			</label>
			<button type="submit">Add key</button>
		</form>
	</section>
}
